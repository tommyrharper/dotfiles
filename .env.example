# Per-machine setup profile. Copy this file to .env before running
# ./bootstrap.sh or ./rebuild.sh - both refuse to run until it is set:
#
#   cp .env.example .env
#
# .env is gitignored, because this is a per-machine choice and never a
# repo-wide one. It is read by setup-env.sh, which turns the value below into
# the flake output bootstrap.sh/rebuild.sh build.
#
# Valid values:
#   personal - full setup: personal Homebrew formulae and GUI casks on macOS
#              (Slack, Discord, Notion, Figma, ...) alongside the shared dev
#              tooling, plus the full TeX Live scheme on every OS.
#   basic    - dev tooling only, e.g. a server: no personal formulae or casks,
#              and the minimal TeX Live scheme (just pdflatex/xelatex).
#   csd3     - basic, for Cambridge's CSD3 cluster (no root, no systemd user
#              services): Nix is nix-portable with its store in ~, used only
#              by interactive login shells; no Docker, ssh-agent, SSH config
#              fragments or Claude settings link. Linux
#              only; see README.md "CSD3".
DOTFILES_SETUP=
# Set to true to also install the blockchain dev tools (scope = "blockchain"
# in tools.nix: foundry, echidna, solc-select, tenderly).
BLOCKCHAIN_DEV=false
# The account this config is built for: it becomes flake.nix's `user`, and so
# home.username, the home directory, and the Linux flake output name. Leave it
# blank to use whoever is logged in, which is what you want unless you are
# building this config for a different account than the one you run it from.
DOTFILES_USER=
